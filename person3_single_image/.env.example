# SatQuery AI - Person 3: Environment Configuration Example
# Copy this file to .env or export these environment variables if enabling real model mode.

# Master toggle for real RS-LLaVA model (Default: false)
# When false: /vqa -> MockVQA, /caption -> MockCaption, /grounding -> MockGrounding
# When true:  /vqa -> RSLLaVAVQA, /caption -> RSLLaVACaption, /grounding -> MockGrounding
SATQUERY_USE_REAL_RSLLAVA=false

# Official RS-LLaVA LoRA adapter & base model
RSLLAVA_MODEL_NAME=BigData-KSU/RS-llava-v1.5-7b-LoRA
RSLLAVA_MODEL_BASE=Intel/neural-chat-7b-v3-3

# Hardware execution settings ('auto', 'cuda', 'cpu')
RSLLAVA_DEVICE=auto
RSLLAVA_TORCH_DTYPE=float16

# Optional quantization (Default: false - set to true only if running with bitsandbytes)
RSLLAVA_LOAD_IN_4BIT=false
RSLLAVA_LOAD_IN_8BIT=false
